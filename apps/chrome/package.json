{
  "name": "staple-chrome",
  "version": "0.1.0",
  "description": "Chrome extension collecting different essential utilities in a single fast, lightweight and scalable extension",
  "license": "MIT",
  "private": true,
  "repository": {
    "type": "git",
    "url": "https://github.com/guello/staple",
    "directory": "apps/chrome"
  },
  "scripts": {
    "build": "node scripts/build.mts",
    "watch": "node scripts/build.mts --watch",
    "check:types": "tsc --noEmit",
    "test": "node scripts/test.mts",
    "package": "pnpm -w run ci && pnpm run build && node scripts/package.mts"
  },
  "devDependencies": {
    "@staple/tools": "workspace:*",
    "@types/node": "^26.2.0",
    "chrome-types": "^0.1.438",
    "typescript": "catalog:"
  }
}
