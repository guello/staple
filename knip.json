{
  "$schema": "./node_modules/knip/schema.json",
  "workspaces": {
    ".": {},
    "apps/chrome": {
      "entry": [
        "src/background.ts",
        "src/action/action.ts",
        "src/options/options.ts",
        "src/**/*.test.ts",
        "scripts/*.mts"
      ],
      "project": ["src/**/*.ts", "scripts/*.mts"]
    },
    "apps/vscode": {
      "entry": ["src/extension.ts", "src/features/toml/client.ts", "src/features/toml/server.ts", "src/**/*.test.ts"],
      "project": ["src/**/*.ts", "scripts/*.mts", "types/*.d.ts"]
    },
    "packages/tools": {
      "project": ["src/**/*.mts"]
    }
  }
}
